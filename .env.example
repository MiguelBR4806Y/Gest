# ─────────────────────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nicagest
DB_PASSWORD=postgres

# ─────────────────────────────────────────────────────────────
# Seguridad
# ─────────────────────────────────────────────────────────────
# Obligatoria. Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Se recomienda 32+ caracteres; si es más corta, el arranque avisa por log.
SECRET_KEY=genera_una_clave_segura_aqui

# Horas de validez del token de sesión (por defecto 12).
TOKEN_EXPIRE_HOURS=12

# Contraseña del usuario 'root' en el primer arranque. Si se deja vacía se
# genera una aleatoria y se muestra una única vez en el log del servidor.
# Nota: ya no existe la contraseña por defecto '1234'.
ROOT_PASSWORD=

# Orígenes permitidos por CORS, separados por coma. El comodín '*' se ignora.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Pon 1 SOLO si la app está detrás de un proxy inverso de confianza que
# sobrescribe X-Forwarded-For. Si no, cualquiera puede falsear su IP y saltarse
# los límites de peticiones.
TRUST_PROXY_HEADERS=0

# Pon 1 cuando sirvas por HTTPS para activar Strict-Transport-Security.
ENABLE_HSTS=0

# Pon 0 para desactivar /docs en producción.
EXPOSER_DOCS=1

# Política de seguridad de contenido. Por defecto ya permite Google Identity
# Services y Google Fonts. Solo hay que tocarla si se añaden recursos externos.
# CONTENT_SECURITY_POLICY=

# ─────────────────────────────────────────────────────────────
# IA (Gesti)
# ─────────────────────────────────────────────────────────────
NICAGEST_IA_MODO=groq
GROQ_API_KEY=tu_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=tu_openai_api_key
# OPENAI_MODEL=gpt-4o
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3.2

# ─────────────────────────────────────────────────────────────
# Negocio
# ─────────────────────────────────────────────────────────────
NOMBRE_NEGOCIO=Mi Negocio
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=tu_google_client_id

# ─────────────────────────────────────────────────────────────
# Correo (SendGrid / SMTP)
# ─────────────────────────────────────────────────────────────
# Sin estas variables el código de verificación queda en el log del servidor
# y nunca se envía al cliente.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=tu_sendgrid_api_key
SMTP_FROM=correo@tudominio.com
